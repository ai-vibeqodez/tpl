{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "asan",
      "displayName": "AddressSanitizer, Debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "AW_TPL_SANITIZE": "address"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer, Debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "AW_TPL_SANITIZE": "thread"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug, coverage",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "AW_TPL_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "asan", "configurePreset": "asan", "configuration": "RelWithDebInfo" },
    { "name": "tsan", "configurePreset": "tsan", "configuration": "RelWithDebInfo" },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "asan", "configurePreset": "asan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
